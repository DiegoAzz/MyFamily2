# ========================================================
# WILDBORN ONLINE — VARIABLES DE ENTORNO PARA COOLIFY / VPS
# ========================================================

NODE_ENV=production
LOG_LEVEL=info

# URLs de Producción (Configurar con tus dominios reales en Coolify)
PUBLIC_WEB_URL=https://juego.tudominio.com
PUBLIC_API_URL=https://api.tudominio.com
PUBLIC_GAME_WSS_URL=wss://play.tudominio.com

# Puertos Internos de Servicios
WEB_PORT=80
API_PORT=4000
GAME_SERVER_PORT=2567

# Base de Datos PostgreSQL
POSTGRES_USER=wildborn
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION_SECRETO_FUERTE
POSTGRES_DB=wildborn_db
DATABASE_URL=postgresql://wildborn:CAMBIAR_EN_PRODUCCION_SECRETO_FUERTE@postgres:5432/wildborn_db

# Seguridad y Autenticación
JWT_SECRET=CAMBIAR_POR_CADENA_ALEATORIA_DE_64_CARACTERES
SESSION_SECRET=CAMBIAR_POR_OTRA_CADENA_ALEATORIA_DE_64_CARACTERES

# Ajustes de Partida
MAX_PLAYERS_PER_ROOM=16
WORLD_SAVE_INTERVAL_SEC=60
